#!ipxe
# Boot Talos into MAINTENANCE mode: talos.platform=metal and NO talos.config,
# so the node comes up on its DHCP lease and waits for `tinq adopt`.
#
# The KSPP + hardening args after talos.platform are REQUIRED, not optional:
# Talos enforces them in its systemRequirements phase (enforceKSPPRequirements)
# and REFUSES to initialize without slab_nomerge + pti=on. The Talos ISO/GRUB
# sets this whole cmdline for you; a hand-written iPXE kernel line must carry it
# too, or the node boots the kernel, mounts the rootfs, and then aborts
# `initialize sequence: failed` before the maintenance API ever opens. This is
# the canonical Talos metal cmdline.
set base http://boot.{{ seed_domain }}
kernel ${base}/vmlinuz-{{ seed_talos_arch }} talos.platform=metal console=tty0 console=ttyS0 init_on_alloc=1 slab_nomerge pti=on consoleblank=0 nvme_core.io_timeout=4294967295 printk.devkmsg=on
initrd ${base}/initramfs-{{ seed_talos_arch }}.xz
boot
