diff --git a/internal/pkg/lvm/activate.go b/internal/pkg/lvm/activate.go
index 57a0ed5..f8e20a8 100644
--- a/internal/pkg/lvm/activate.go
+++ b/internal/pkg/lvm/activate.go
@@ -28,6 +28,22 @@ func (lvm *LVM) VGChangeActivate(ctx context.Context, vgName string) error {
 	return nil
 }
 
+// VGChangeDeactivate deactivates the given volume group via
+// `lvm vgchange -an <vg>`, releasing every logical volume in it.
+//
+// This is the unwind of VGChangeActivate, and it exists for teardown: a VG
+// stacked on an encrypted volume keeps the LUKS mapper open, so `cryptsetup
+// luksClose` fails with "mapped device is still in use" until the VG is
+// deactivated. Deactivation is NOT destructive -- no metadata is touched, and
+// the VG reactivates normally on the next boot.
+func (lvm *LVM) VGChangeDeactivate(ctx context.Context, vgName string) error {
+	if _, err := lvm.run(ctx, "vgchange", "-an", vgName); err != nil {
+		return fmt.Errorf("deactivate volume group %q: %w", vgName, err)
+	}
+
+	return nil
+}
+
 // PVScanAutoActivation runs `lvm pvscan --cache --listvg --checkcomplete
 // --vgonline --autoactivation event --udevoutput <devicePath>` and returns the
 // parsed udev-style key/value pairs.
