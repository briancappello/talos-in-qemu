-machine
q35,accel=kvm
-cpu
host
-smp
4
-m
6144
-drive
if=pflash,format=raw,readonly=on,file=<FIRMWARE>/OVMF_CODE.fd
-drive
if=pflash,format=raw,file=<STATE_ROOT>/clvc-local/bootstrap-default-clvc-cp0/efivars.fd
-uuid
bd3b592f-494a-400b-b989-0ce7e8ebc7e3
-drive
if=none,id=sys,format=qcow2,file=<STATE_ROOT>/clvc-local/bootstrap-default-clvc-cp0/system.qcow2
-device
virtio-blk-pci,drive=sys,serial=talos-system,bootindex=0
-drive
if=none,id=cd,media=cdrom,file=<IMAGE_ROOT>/talos-v1.13.7-amd64.iso
-device
virtio-blk-pci,drive=cd,bootindex=99
-netdev
user,id=n0,hostfwd=tcp:127.0.0.1:50000-:50000,hostfwd=tcp:127.0.0.1:6443-:6443
-device
virtio-net-pci,netdev=n0
-device
virtio-rng-pci
-display
none
-serial
file:<STATE_ROOT>/clvc-local/bootstrap-default-clvc-cp0/serial.log
-pidfile
<STATE_ROOT>/clvc-local/bootstrap-default-clvc-cp0/qemu.pid
-daemonize
-drive
if=none,id=data,format=qcow2,file=<STATE_ROOT>/clvc-local/bootstrap-default-clvc-cp0/data.qcow2
-device
virtio-blk-pci,drive=data,serial=talos-data
